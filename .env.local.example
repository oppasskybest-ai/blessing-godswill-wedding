# ============================================================
# Blessing & Godswill wedding site: environment variables
# Copy to .env.local and fill in your values. Never commit .env.local.
# ============================================================

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# SERVER ONLY. Used by /api/register and /api/admin/reset-password. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Site (set to the real domain once bought)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Guests log in with a username. Supabase Auth needs an email, so each guest gets
# a private stand-in address: <username>@<this domain>. It is never emailed.
# Keep a domain nobody can register (example.com subdomains are reserved by IANA).
NEXT_PUBLIC_GUEST_EMAIL_DOMAIN=guests.example.com
